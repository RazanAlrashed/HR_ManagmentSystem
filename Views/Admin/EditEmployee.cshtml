@using HR_ManagmentSystem.Models.BaseModel
@model Employee

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var getdataDepartment = ViewBag.getdataDepartment;
    var getdataDesignation = ViewBag.getdataDesignation;
}

<div class="container">
    <div class="row mt-5 justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg rounded">
                <div class="card-body">
                    <h4 class="card-title text-center mb-4">Edit Employee</h4>
                    <form asp-action="UpdateEmployee" method="post">
                        <input type="hidden" asp-for="Id" />

                        <!-- Employee Number & Name -->
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label">Employee Number</label>
                                <input type="text" asp-for="EmployeeNumber" class="form-control" />
                            </div>
                            <div class="col">
                                <label class="form-label">Employee Name</label>
                                <input type="text" asp-for="EmployeeName" class="form-control" />
                            </div>
                        </div>

                        <!-- Email & Contact Number -->
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label">Email</label>
                                <input type="text" asp-for="Email" class="form-control" />
                            </div>
                            <div class="col">
                                <label class="form-label">Contact Number</label>
                                <input type="text" asp-for="ContactNumber" class="form-control" />
                            </div>
                        </div>

                        <!-- Department & Designation -->
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label">Department</label>
                                <select class="form-select" name="Department">
                                    <option>Select Department</option>
                                    @foreach (var item in getdataDepartment)
                                    {
                                        <option value="@item.Id">@item.DepartmentName</option>
                                    }
                                </select>
                            </div>
                            <div class="col">
                                <label class="form-label">Designation</label>
                                <select class="form-select" name="DesignationName">
                                    <option>Select Designation</option>
                                    @foreach (var item in getdataDesignation)
                                    {
                                        <option value="@item.Id">@item.Designations</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Salary & Bank Information -->
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label">Salary</label>
                                <input type="text" asp-for="Salary" class="form-control" />
                            </div>
                            <div class="col">
                                <label class="form-label">Bank Name</label>
                                <input type="text" asp-for="BankName" class="form-control" />
                            </div>
                        </div>

                        <!-- Bank Account & Nationality -->
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label">Bank Account Number</label>
                                <input type="text" asp-for="BankAccountNumber" class="form-control" />
                            </div>
                            <div class="col">
                                <label class="form-label">Nationality</label>
                                <input type="text" asp-for="Nationality" class="form-control" />
                            </div>
                        </div>

                        <!-- Address -->
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label">Address</label>
                                <input type="text" asp-for="Address" class="form-control" />
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="row mt-3">
                            <div class="col text-center">
                                <button type="submit" class="btn btn-primary px-4 py-2">Update</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    h2 {
        text-align: center;
        margin-bottom: 30px; 
    }

    .form-control {
        padding: 10px;
        font-size: 16px;
        border-radius: 5px;
        margin-bottom: 20px; 
    }

    .form-select {
        padding: 10px;
        font-size: 16px;
        border-radius: 5px;
        margin-bottom: 20px; 
    }

    .btn-hover {
        padding: 10px 20px;
        border-radius: 5px;
        font-size: 16px;
        margin-top: 20px; 
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 30px; 
    }

    th, td {
        padding: 12px;
        text-align: center;
        vertical-align: middle;
    }

    th {
        background-color: #f8f9fa;
        color: #333;
        font-weight: bold;
    }

    tr:hover {
        background-color: #f1f1f1;
    }

    .table-striped tbody tr:nth-child(odd) {
        background-color: #f9f9f9;
    }

    .table-bordered td, .table-bordered th {
        border: 1px solid #ddd;
    }

    #searchInput {
        padding: 10px;
        font-size: 16px;
        border-radius: 5px;
        width: 50%;
        margin: 0 auto;
        display: block;
        margin-bottom: 30px; 
    }

    .text-center {
        text-align: center;
    }

    media (max-width: 768px) {
        .table thead

    {
        font-size: 12px;
    }

    .table td {
        font-size: 12px;
    }

    .form-control, .form-select {
        width: 100%;
    }

    #searchInput {
        width: 100%;
    }

    }
</style>
