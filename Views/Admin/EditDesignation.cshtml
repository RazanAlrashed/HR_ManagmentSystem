@using HR_ManagmentSystem.Models.BaseModel
@model Designation
@{
	Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<style>
    h2 {
        text-align: center;
        font-size: 48px;
        font-weight: bold;
        color: #000;
        margin: 10px;
    }

    .container {
        display: flex;
        justify-content: center; 
        align-items: center; 
        height: 100vh; 
    }

    .card {
        width: 100%;
        max-width: 800px;
        background: #fff;
        padding: 20px;
        border-radius: 6px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        margin: 20px;
    }

    .card-header {
        font-size: 22px;
        font-weight: bold;
        color: #333;
        text-align: center;
        margin-bottom: 20px;
    }

    .row {
        display: flex;
        justify-content: space-between;
        width: 100%;
        margin-bottom: 20px;
    }

    .col {
        flex: 1;
        margin-right: 15px;
    }

        .col:last-child {
            margin-right: 0;
        }

    .input-box input {
        width: 100%;
        padding: 10px;
        margin-top: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    .button-1 {
        background-color: #5A7A99;
        color: #fff;
        border: none;
        padding: 12px 25px;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
        margin-top: 10px;
    }

        .button-1:hover {
            background-color: #4A6A89;
        }

    .text-center {
        display: flex;
        justify-content: center;
    }
</style>

<div class="container">
    <div class="card">
        <div class="card-header">
            <strong>Edit Department</strong>
        </div>
        <div class="card-body">
            <form asp-action="UpdateDesignation" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="row">
                    <div class="col">
                        <label class="form-label">Designation</label>
                        <input type="text" asp-for="Designations" class="form-control" />
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col text-center">
                        <button type="submit" class="button-1">Update</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


