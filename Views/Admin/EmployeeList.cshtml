@model IEnumerable<HR_ManagmentSystem.Models.BaseModel.Employee>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var getEmployeeInfo = ViewBag.getEmployeeInfo as IEnumerable<dynamic>;
}

<div class="container">
    <h2 class="text-center mb-4">Employee Information</h2>

    <!-- Search Box -->
    <div class="mb-4 text-center">
        <input type="text" id="searchInput" class="form-control w-50 mx-auto" style="margin:10px;" placeholder="Search by Employee Name or Department" onkeyup="searchTable()" />
    </div>

    <table class="table table-striped table-bordered" id="employeeTable">
        <thead>
            <tr>
                <th>Employee Number</th>
                <th>Employee Name</th>
                <th>Email</th>
                <th>Contact Number</th>
                <th>Department</th>
                <th>Designation</th>
                <th>Salary</th>
                <th>Bank Name</th>
                <th>Bank Account Number</th>
                <th>Nationality</th>
                <th>Address</th>
                <th colspan="2">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (getEmployeeInfo != null)
            {
                foreach (var item in getEmployeeInfo)
                {
                    <tr>
                        <td>@item.EmployeeNumber</td>
                        <td>@item.EmployeeName</td>
                        <td>@item.Email</td>
                        <td>@item.ContactNumber</td>
                        <td>@item.DepartmentName</td>
                        <td>@item.DesignationName</td>
                        <td>@item.Salary</td>
                        <td>@item.BankName</td>
                        <td>@item.BankAccountNumber</td>
                        <td>@item.Nationality</td>
                        <td>@item.Address</td>
                        <td>
                            <a asp-action="EditEmployee" asp-route-id="@item.EmployeeId" class="text-success">
                                <i class="fa fa-pencil" aria-hidden="true"></i>
                            </a>
                        </td>
                        <td>
                            <a asp-action="DeletEmployee" asp-route-id="@item.EmployeeId" class="text-danger">
                                <i class="fa fa-trash" aria-hidden="true"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="12" class="text-center">No employee data available.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="row">
        <div class="col">
            <a href="@Url.Action("ExportEmployeeListToExcel")" class="button-1">Export to Excel</a>

        </div>
    </div>
</div>

<script>
    function searchTable() {
        var input = document.getElementById("searchInput");
        var filter = input.value.toLowerCase();

        var table = document.getElementById("employeeTable");
        var rows = table.getElementsByTagName("tr");

        for (var i = 1; i < rows.length; i++) {  
            var cells = rows[i].getElementsByTagName("td");
            var employeeName = cells[1].textContent || cells[1].innerText; // Employee Name is in the 2nd column (index 1)
            var departmentName = cells[4].textContent || cells[4].innerText; // Department Name is in the 5th column (index 4)

            if (employeeName.toLowerCase().indexOf(filter) > -1 || departmentName.toLowerCase().indexOf(filter) > -1) {
                rows[i].style.display = ""; 
            } else {
                rows[i].style.display = "none"; 
            }
        }
    }
</script>

<style>
    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 12px;
        text-align: center;
        vertical-align: middle;
    }

    th {
        background-color: #f8f9fa;
        color: #333;
        font-weight: bold;
    }

    tr:hover {
        background-color: #f1f1f1;
    }

    .table-striped tbody tr:nth-child(odd) {
        background-color: #f9f9f9;
    }

    .text-center {
        text-align: center;
    }

    .form-control {
        padding: 10px;
        font-size: 16px;
        border-radius: 5px;
    }

    .btn-action {
        cursor: pointer;
        font-size: 18px;
    }

        .btn-action:hover {
            color: #007bff;
        }

    media (max-width: 768px) {
        .table thead

    {
        font-size: 12px;
    }

    .table td {
        font-size: 12px;
    }

    .form-control {
        width: 100%;
    }

    }

    .button-1 {
        background-color: #5A7A99;
        color: #fff;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s;
        margin-top: 10px;
        justify-content:center;
    }

        .button-1:hover {
            background-color: #4A6A89;
        }
</style>
